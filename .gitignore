.DS_Store
.env
.venv/
.uv-cache/
__pycache__/
*.pyc
data/
data/inputs/
data/cache/
data/outputs/
# `src/ohbm2026/data/` is committed package data (e.g. ECO vocabulary file);
# the `data/` patterns above were intended for the top-level gitignored
# artifact root, not for source-tree package data.
!src/ohbm2026/data/
!src/ohbm2026/data/**
# ...but that negation is broad enough to re-include build cruft inside the
# package-data dir, which the global `__pycache__/` rule above would otherwise
# have caught. Re-ignore it here (last matching pattern wins) so importing
# `ohbm2026.data` never leaves untracked bytecode behind (Principle II —
# generated files are never committed).
src/ohbm2026/data/__pycache__/
src/ohbm2026/data/**/__pycache__/
src/ohbm2026/data/**/*.py[cod]
.cache/
.matplotlib/
export/

# Local experiment and scratch outputs
.matplotlib-cache/
experiments/*
!experiments/README.md
!experiments/2026-03-30-topic-clustering-optimization/
!experiments/2026-03-30-topic-clustering-optimization/**/
!experiments/2026-03-30-topic-clustering-optimization/**/*.md
!experiments/2026-03-30-topic-clustering-optimization/.gitignore
logs/
tmp/

# Local working memory archives
archive/
memory/archive/

# Local Claude Code session state
.claude/

# Local packaging and lock artifacts
src/*.egg-info/
uv.lock
build/

# Stage 4 artifact roots (Principle II)
data/outputs/analysis/
data/cache/analysis/
data/provenance/analysis/
data/inputs/neuroscape/
bench/

# Stage 15 artifact roots (spec 015-neuroscape-context, Principle II)
data/inputs/neuroscape-source/
data/cache/atlas-umap/
data/cache/atlas-projection/
data/cache/atlas-neighbours/
data/cache/atlas-runs/
data/outputs/atlas-package/
data/outputs/parquets/
data/provenance/neuroscape_context_provenance__*.json

# Stage 20 artifact roots (spec 020-cloudflare-r2-migration, Principle II)
data/provenance/atlas_upload_provenance__*.json
data/outputs/data-hosting-comparison__*.json
